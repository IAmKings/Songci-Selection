-- 宋词选粹 · 数据模型
-- 与预建库 db/songci.db 结构一致;运行时以预建库打开,schema 不落地执行。

CREATE TABLE authors (
    id INTEGER PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    long_desc TEXT
);

CREATE TABLE poems (
    id INTEGER PRIMARY KEY NOT NULL,
    author_id INTEGER,
    rhythmic TEXT NOT NULL,
    content TEXT NOT NULL,
    recommended_date INTEGER
);

CREATE TABLE favorites (
    poem_id INTEGER PRIMARY KEY NOT NULL,
    created_at TEXT NOT NULL DEFAULT (datetime('now'))
);

CREATE TABLE recent_views (
    poem_id INTEGER PRIMARY KEY NOT NULL,
    viewed_at INTEGER NOT NULL DEFAULT ((julianday('now') - 2440587.5) * 86400000)
);

CREATE TABLE recommendation_pool (
    date INTEGER PRIMARY KEY NOT NULL,
    poem_ids TEXT NOT NULL
);

-- ===== 查询 =====

-- 随机词:过滤异常字符(与 dailyCandidates 同源,加缺字),widget/首页随机入口共用
randomPoems:
SELECT p.id, p.rhythmic, p.content, a.id AS author_id, a.name AS author_name
FROM poems p JOIN authors a ON a.id = p.author_id
WHERE p.rhythmic NOT LIKE '%⿰%'
  AND instr(p.content, '⿰') = 0
  AND instr(p.content, '𠴇') = 0
  AND instr(p.content, '𫍙') = 0
  AND length(p.rhythmic) <= 12
  AND instr(p.content, char(10)) > 0
ORDER BY RANDOM() LIMIT ?;

poemById:
SELECT p.id, p.rhythmic, p.content, p.author_id, a.name AS author_name
FROM poems p JOIN authors a ON a.id = p.author_id
WHERE p.id = ?;

allAuthors:
SELECT id, name, long_desc FROM authors ORDER BY name;

authorById:
SELECT id, name, long_desc FROM authors WHERE id = ?;

poemsByAuthor:
SELECT p.id, p.rhythmic, p.content FROM poems p
WHERE p.author_id = ? ORDER BY p.id;

allRhythmics:
SELECT DISTINCT rhythmic FROM poems ORDER BY rhythmic;

poemsByRhythmic:
SELECT p.id, p.rhythmic, p.content, a.id AS author_id, a.name AS author_name
FROM poems p JOIN authors a ON a.id = p.author_id
WHERE p.rhythmic = ? OR p.rhythmic LIKE '%⿰%·' || ?   -- 含 ⿰ 变体(⿰⿰⿰·七娘子)归入主词牌
ORDER BY p.id LIMIT ?;

poemsByRhythmicContains:
SELECT p.id, p.rhythmic, p.content, a.id AS author_id, a.name AS author_name
FROM poems p JOIN authors a ON a.id = p.author_id
WHERE p.rhythmic LIKE '%' || ? || '%'   -- 词牌筛选模糊匹配(水→水调歌头/水龙吟)
ORDER BY p.id LIMIT ?;

-- 全文搜索:21k 行规模用 LIKE 全扫(实测 <20ms),规避 FTS5 unicode61 对中文整段分词的问题
search:
SELECT p.id, p.rhythmic, p.content, a.id AS author_id, a.name AS author_name
FROM poems p JOIN authors a ON a.id = p.author_id
WHERE p.content LIKE '%' || ? || '%'
   OR a.name LIKE '%' || ? || '%'
   OR p.rhythmic LIKE '%' || ? || '%'
   OR a.long_desc LIKE '%' || ? || '%'   -- 作者号/别称(友古居士→蔡伸),实测增量 ~4ms
ORDER BY p.id LIMIT ?;

favorites:
SELECT p.id, p.rhythmic, p.content, a.id AS author_id, a.name AS author_name, f.created_at
FROM favorites f
JOIN poems p ON f.poem_id = p.id
JOIN authors a ON a.id = p.author_id
ORDER BY f.created_at DESC;

insertFavorite:
INSERT OR REPLACE INTO favorites (poem_id) VALUES (?);

deleteFavorite:
DELETE FROM favorites WHERE poem_id = ?;

-- 最近查看:进入详情页记录(openPoem 统一入口);INSERT OR REPLACE 同词刷新时间戳 = 去重置顶;
-- viewed_at 为 epoch 毫秒,毫秒级精度保证「最新在前」排序稳定(秒级 datetime 同秒多查会乱序)。
recentViews:
SELECT p.id, p.rhythmic, p.content, a.id AS author_id, a.name AS author_name
FROM recent_views r
JOIN poems p ON r.poem_id = p.id
JOIN authors a ON a.id = p.author_id
ORDER BY r.viewed_at DESC LIMIT ?;

recordView:
INSERT OR REPLACE INTO recent_views (poem_id) VALUES (?);

-- 上限裁剪:保留最近 N 条(每次记录后调用,自动淘汰最旧)
trimRecentViews:
DELETE FROM recent_views WHERE poem_id NOT IN (
    SELECT poem_id FROM recent_views ORDER BY viewed_at DESC LIMIT ?
);

-- ===== 每日推荐池 =====

poolByDate:
SELECT poem_ids FROM recommendation_pool WHERE date = ?;

insertPool:
INSERT OR REPLACE INTO recommendation_pool (date, poem_ids) VALUES (?, ?);

-- 候选:未推荐 + 基础异常过滤(词牌/内容无 ⿰;词牌 ≤12 字;内容至少 2 行)。
-- 缺字过滤在应用层(字体缺失字符集,SQL 侧 json_each 不被 SQLDelight 支持)
dailyCandidates:
SELECT p.id, p.rhythmic, p.content, a.id AS author_id, a.name AS author_name
FROM poems p JOIN authors a ON a.id = p.author_id
WHERE p.recommended_date IS NULL
  AND p.rhythmic NOT LIKE '%⿰%'
  AND instr(p.content, '⿰') = 0
  AND length(p.rhythmic) <= 12
  AND instr(p.content, char(10)) > 0
ORDER BY RANDOM() LIMIT ?;

markRecommended:
UPDATE poems SET recommended_date = ? WHERE id IN ?;

resetRecommendations:
UPDATE poems SET recommended_date = NULL WHERE recommended_date IS NOT NULL;

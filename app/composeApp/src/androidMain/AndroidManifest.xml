<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 每日一词通知(Android 13+ 运行时权限;未授予则 Worker 静默跳过) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内检查更新:查询 GitHub Release API(零新依赖,HttpURLConnection) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".SongciApp"
        android:icon="@mipmap/ic_launcher"
        android:label="宋词选粹"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- 桌面小组件:四规格独立条目(与 macOS 四规格对应,2x2/4x1/4x2/4x4) -->
        <receiver
            android:name=".widget.SongciWidgetReceiver"
            android:exported="true"
            android:label="宋词选粹·小">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/songci_widget_small" />
        </receiver>
        <receiver
            android:name=".widget.SongciWidgetBannerReceiver"
            android:exported="true"
            android:label="宋词选粹·横幅">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/songci_widget_banner" />
        </receiver>
        <receiver
            android:name=".widget.SongciWidgetMediumReceiver"
            android:exported="true"
            android:label="宋词选粹·中">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/songci_widget_medium" />
        </receiver>
        <receiver
            android:name=".widget.SongciWidgetLargeReceiver"
            android:exported="true"
            android:label="宋词选粹·大">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/songci_widget_large" />
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>   <!-- 小组件 deep link: songci://poem/{id} -->
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="songci" android:host="poem" />
            </intent-filter>
        </activity>
    </application>
</manifest>
